# ===== 모드 =====
# 기본은 테스트 모드(가상 KRW). 실자금 모드는 아래를 true로 바꾸고 README의 '실자금 모드' 요구사항을 모두 채워야 기동된다.
REAL_MONEY_MODE=false
TEST_MODE_INITIAL_KRW=100000000

# ===== 코인 =====
COIN_NAME=PIKU
COIN_TICKER=PIKU
COIN_ALGORITHM=sha256d
BLOCK_TIME_SEC=600

# ===== 코인 노드 JSON-RPC (docker-compose에 포함되지 않음) =====
# 노드가 호스트에서 돌면 host.docker.internal, 다른 서버면 그 IP
RPC_HOST=host.docker.internal
RPC_PORT=8332
RPC_USER=piku
RPC_PASSWORD=change-me
RPC_WALLET=
# 블록 보상을 받을 풀 주소 (비우면 노드 지갑에서 새로 생성)
POOL_ADDRESS=

# ===== 서비스 =====
POSTGRES_PASSWORD=piku
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:8000
# 이 이메일로 가입하면 관리자(+운영자: 자사 코인 거래 금지) 권한
ADMIN_EMAILS=admin@example.com

# ===== Stratum =====
STRATUM_PORT=3333
STRATUM_PUBLIC_HOST=localhost
STRATUM_INITIAL_DIFF=16
STRATUM_MIN_DIFF=0.001
POOL_TAG=/PIKU-pool/

# ===== 이메일 (비우면 콘솔에 인증 링크 출력, 테스트 모드에서는 자동 인증) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PIKU Exchange <no-reply@example.com>

# ===== 실자금 모드 필수 =====
VASP_REGISTRATION_NO=
LEGAL_REVIEW_ACK=
