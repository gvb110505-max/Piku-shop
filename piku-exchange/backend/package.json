{
  "name": "piku-backend",
  "version": "1.0.0",
  "description": "PIKU mining pool + exchange backend",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:engine": "tsx watch src/engine/main.ts",
    "dev:stratum": "tsx watch src/stratum/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "start:api": "node dist/api/main.js",
    "start:engine": "node dist/engine/main.js",
    "start:stratum": "node dist/stratum/main.js",
    "start:worker": "node dist/worker/main.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true
}
